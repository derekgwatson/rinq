# Rinq Configuration
FLASK_SECRET_KEY=change-me-to-a-random-string

# Google OAuth (required for login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Twilio (required for phone functionality)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_DEFAULT_CALLER_ID=
TWILIO_SIP_CREDENTIAL_LIST_SID=

# Server
PORT=5000
RINQ_WEBHOOK_URL=https://your-domain.com

# Multi-tenant (optional — omit for single-tenant)
# RINQ_MULTI_TENANT=true
# RINQ_DATA_DIR=/path/to/data

# Domain restrictions (optional, comma-separated)
# RINQ_ALLOWED_DOMAINS=example.com,other.com
# RINQ_ADMIN_EMAILS=admin@example.com

# TTS (optional)
# ELEVENLABS_API_KEY=
# CARTESIA_API_KEY=

# Voicemail transcription (optional). When set, voicemails are
# transcribed via OpenAI Whisper instead of Twilio's transcribeCallback.
# Whisper is far more accurate on accents/names/numbers and cheaper.
# OPENAI_API_KEY=

# Google Workspace (optional, for recordings via Drive/Gmail)
# GOOGLE_CREDENTIALS_FILE=/path/to/credentials.json
# GOOGLE_WORKSPACE_ADMIN_EMAIL=admin@example.com

# Watson Blinds integration (only when running inside bot-team)
# RINQ_AUTH=gateway
# RINQ_INTEGRATIONS=watson
# BOT_API_KEY=
# WATSON_CLARA_URL=https://clara.watsonblinds.com.au
# WATSON_OTTO_URL=https://otto.watsonblinds.com.au
# WATSON_MABEL_URL=https://mabel.watsonblinds.com.au

# Ticket provider (default: sadie/zendesk via the watson integration;
# 'zelda' posts straight to Zelda's native ticket API, 'zendesk' uses the
# Zendesk API directly)
# RINQ_TICKET_PROVIDER=zelda
# WATSON_ZELDA_URL=https://zelda.watsonblinds.com.au

# Email provider (auto-detected: mabel if WATSON_MABEL_URL set, else resend if RESEND_API_KEY set)
# RINQ_EMAIL_PROVIDER=mabel  # or resend
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
